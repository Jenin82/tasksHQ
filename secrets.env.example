# Worker secrets. Copy to secrets.env (gitignored). The deploy scripts upload
# them with `cf deploy --secrets-file`; each Worker receives only the keys it
# declares.
#
# Each listed key overwrites the deployed value. A key you leave out keeps its
# current value on an existing Worker; a new Worker needs every required key.
# Fill in each line or delete it: `node scripts/check-deploy.mjs` rejects empty
# values, because cf would upload them as empty secrets.
#
# Use literal KEY=value lines. Quote a value that contains `#`, and write a
# literal `$` as `\$`.

# Required. Random 32+ char value. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Required. Origin Better Auth builds callback URLs from. Must be explicit or
# the Google callback defaults to localhost and the provider answers
# redirect_uri_mismatch. Use the same value as TASKSHQ_WEB_URL in deploy.env.
BETTER_AUTH_URL=

# Required. From the Google Cloud console, APIs & Services > Credentials >
# OAuth 2.0 Client ID (type "Web application"). Add
# <BETTER_AUTH_URL>/api/auth/callback/google as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required. Separate random values of at least 32 characters, each from:
#   openssl rand -base64 32
# CONSENT_SECRET signs remembered consent. INTROSPECT_SECRET is uploaded to
# both the web and MCP Workers, which must share the same value.
CONSENT_SECRET=
INTROSPECT_SECRET=

# Optional. Uncomment to enable email. All SMTP settings except the port are
# needed. SMTP_TLS=tls (port 465) or starttls (port 587).
# SMTP_HOST=
# SMTP_PORT=
# SMTP_TLS=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=

# Optional new-account policy. Valid pending invites bypass it.
# SIGNUP_EMAIL_ALLOWLIST=*@domain.com,test@gmail.com
