# Deployment settings. Copy to deploy.env (gitignored) and fill in.
# Both cloudflare.config.ts files load this file; none of it is secret.
# Format: plain KEY=value lines; quote a value that contains `#`.
# `node scripts/check-deploy.mjs` checks it before every remote command.

# Public origin of the web Worker, without a trailing slash.
# e.g. https://taskshq.example.com or https://taskshq-web.<subdomain>.workers.dev
TASKSHQ_WEB_URL=

# Public origin of the MCP Worker, without a trailing slash. The MCP server
# URL clients connect to is this origin followed by /mcp.
# e.g. https://taskshq-mcp.example.com or https://taskshq-mcp.<subdomain>.workers.dev
TASKSHQ_MCP_URL=

# Optional custom domains (hostname only). Leave empty to serve the Workers
# on workers.dev only.
TASKSHQ_WEB_DOMAIN=
TASKSHQ_MCP_DOMAIN=

# Required. The ID printed by `cf d1 create --name taskshq-db`. For local
# development only, any UUID works.
TASKSHQ_D1_ID=

# Optional. The OAuth KV namespace ID. Leave empty to let cf create one on the
# first deploy, then record its ID here so later deploys reuse it.
TASKSHQ_KV_ID=

# Optional resource names. These are the defaults.
TASKSHQ_WEB_WORKER=taskshq-web
TASKSHQ_MCP_WORKER=taskshq-mcp
TASKSHQ_D1_NAME=taskshq-db
TASKSHQ_R2_BUCKET=taskshq-images
