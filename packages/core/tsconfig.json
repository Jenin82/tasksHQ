{
  "compilerOptions": {
    "target": "ES2022",
    // WebWorker, not DOM: the package targets Workers, and `crypto.randomUUID`
    // lives there.
    "lib": ["ESNext", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["src/**/*.ts"]
}
